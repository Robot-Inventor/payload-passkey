{
  "name": "payload-passkey",
  "version": "2.0.0",
  "description": "Add passkey support to Payload CMS.",
  "keywords": [
    "payloadcms",
    "payload-plugin",
    "passkey"
  ],
  "homepage": "https://github.com/Robot-Inventor/payload-passkey#readme",
  "bugs": {
    "url": "https://github.com/Robot-Inventor/payload-passkey/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Robot-Inventor/payload-passkey.git"
  },
  "license": "MIT",
  "author": "Robot-Inventor",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "./dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./components/BetterAuthSessionRefreshProvider": {
      "import": "./dist/components/BetterAuthSessionRefreshProvider.js",
      "types": "./dist/components/BetterAuthSessionRefreshProvider.d.ts"
    },
    "./components/PasskeyLoginButton": {
      "import": "./dist/components/PasskeyLoginButton.js",
      "types": "./dist/components/PasskeyLoginButton.d.ts"
    },
    "./components/PasskeyManagementField": {
      "import": "./dist/components/PasskeyManagementField.js",
      "types": "./dist/components/PasskeyManagementField.d.ts"
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "format": "prettier --write ./src",
    "format:check": "prettier --check ./src",
    "test": "vitest run",
    "lint": "tsc --noEmit && knip && eslint \"./src/**/*.{ts,tsx}\"",
    "typedoc": "typedoc --plugin typedoc-plugin-markdown --out docs/api --cleanOutputDir --excludePrivate --includeVersion --readme none ./src/index.ts",
    "build": "tsdown --minify",
    "ci:version": "changeset version && bun run typedoc && git add .",
    "ci:publish": "bun run build && changeset publish"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.1",
    "@delmaredigital/payload-better-auth": "^0.11.0",
    "better-auth": "^1.7.1"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@robot-inventor/eslint-config": "^13.0.3",
    "@robot-inventor/tsconfig-base": "^7.1.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@testing-library/react": "^16.3.2",
    "@types/babel__core": "^7.20.5",
    "@types/react": "^19.2.18",
    "@vanilla-extract/css": "^1.21.2",
    "@vanilla-extract/rollup-plugin": "^1.5.4",
    "@vitejs/plugin-react": "^6.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.9.1",
    "jiti": "^2.7.0",
    "knip": "^6.32.2",
    "linkedom": "^0.18.13",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsdown": "^0.22.14",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@payloadcms/translations": ">=3.69.0 <4",
    "@payloadcms/ui": ">=3.69.0 <4",
    "next": "^16",
    "payload": ">=3.69.0 <4",
    "react": ">=19"
  },
  "overrides": {
    "zod-validation-error": "^5.0.0"
  }
}
