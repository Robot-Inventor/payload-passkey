{
  "name": "payload-passkey",
  "version": "2.1.5",
  "description": "Add passkey support to Payload CMS.",
  "keywords": [
    "passkey",
    "payload-plugin",
    "payloadcms"
  ],
  "homepage": "https://github.com/Robot-Inventor/payload-passkey#readme",
  "bugs": {
    "url": "https://github.com/Robot-Inventor/payload-passkey/issues"
  },
  "license": "MIT",
  "author": "Robot-Inventor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Robot-Inventor/payload-passkey.git"
  },
  "files": [
    "./dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.styles.js"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./components/BetterAuthSessionRefreshProvider": {
      "import": "./dist/components/BetterAuthSessionRefreshProvider.js",
      "types": "./dist/components/BetterAuthSessionRefreshProvider.d.ts"
    },
    "./components/PasskeyLoginButton": {
      "import": "./dist/components/PasskeyLoginButton.js",
      "types": "./dist/components/PasskeyLoginButton.d.ts"
    },
    "./components/PasskeyManagementField": {
      "import": "./dist/components/PasskeyManagementField.js",
      "types": "./dist/components/PasskeyManagementField.d.ts"
    }
  },
  "scripts": {
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest",
    "lint": "tsc --noEmit && knip && oxlint ./src",
    "typedoc": "typedoc --plugin typedoc-plugin-markdown --out docs/api --cleanOutputDir --excludePrivate --includeVersion --readme none ./src/index.ts",
    "build": "tsdown --minify",
    "ci:version": "changeset version && bun run typedoc && git add .",
    "ci:publish": "bun run build && changeset publish"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.14",
    "@delmaredigital/payload-better-auth": "^0.14.0",
    "better-auth": "^1.7.14"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@robot-inventor/oxlint-config": "^1.1.0",
    "@robot-inventor/tsconfig-base": "^7.2.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vanilla-extract/css": "^1.21.3",
    "@vanilla-extract/rollup-plugin": "^1.5.4",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "knip": "^6.43.0",
    "linkedom": "^0.18.14",
    "oxc-transform-react": "^0.156.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.2",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@payloadcms/translations": ">=3.69.0 <4",
    "@payloadcms/ui": ">=3.69.0 <4",
    "next": "^16",
    "payload": ">=3.69.0 <4",
    "react": ">=19"
  }
}
