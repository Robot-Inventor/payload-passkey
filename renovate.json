{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["config:recommended"],
    "baseBranches": ["main", "payload-4"],
    "lockFileMaintenance": {
        "enabled": true
    },
    "rangeStrategy": "bump",
    "packageRules": [
        {
            "description": "Keep peer dependency ranges broad",
            "matchDepTypes": ["peerDependencies"],
            "rangeStrategy": "widen"
        },
        {
            "description": "Track Payload v4 beta, RC, and stable releases instead of internal or canary builds",
            "matchBaseBranches": ["payload-4"],
            "matchPackageNames": ["payload", "@payloadcms/**"],
            "allowedVersions": "/^4\\.(?:0\\.0-(?:beta|rc)\\.\\d+|\\d+\\.\\d+)$/"
        }
    ],
    "minimumReleaseAge": "2 days",
    "minimumReleaseAgeBehaviour": "timestamp-optional"
}
